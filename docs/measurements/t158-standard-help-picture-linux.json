  "implementation": {
    "core": "Bound standard Help commands expose the existing StdPicture.Help resource. Explicit pictures retain precedence. Empty Ref=0 has no missing-resource diagnostic. Explicit picture-only mode stays blank without an image; unavailable references still retain their warning and text fallback.",
    "renderer": "Ordinary Linux picture-only buttons use half the native horizontal padding, a 16-px picture and the existing control height. Mixed captions keep the right text padding and use its remaining half as the gap. Existing root-toolbar mixed padding is retained.",
    "caption": "Regular non-italic button captions reuse wordTextAdvances; bold/italic and tabs keep their existing calibrated measurement. Local Cyrillic controls prove this is not a standard-command or form-name exception.",
    "newDependencies": false,
    "newProtocolFields": false,
    "sourceWrites": false,
    "formNameExceptions": false,
    "coreCommit": "c8caf88864fcaafad476f7f1aa750a90043bf104",
    "rendererCommit": "462222fd5a06d646140d3c927d86f5c6eec6a93d",
    "protocolBehaviorChange": "The existing buttonRepresentation field now preserves explicitly selected Picture even when picture is null. Consumers must honor that mode instead of substituting a caption; no JSON field or enum value was added."
  },
