  "rules": [
    "Common picture payload override is global to base and own extension forms.",
    "Borrowed metadata without Picture Extended and without payload inherits the preceding picture.",
    "Picture Extended without external payload explicitly clears the image.",
    "An empty Picture imported by 1C exports a zero-byte Picture.zip, which is also an explicit empty image.",
    "An unrelated own common picture remains unchanged.",
    "An initially empty base or own-extension common picture has no Ext payload and is valid empty, not a missing-image diagnostic."
  ],
  "applicabilityChecks": [
    {
      "variant": "clear",
      "exitCode": 0,
      "logSha256": "f1945cd6c19e56b3c1c78943ef5ec18116907a4ca1efc40a57d48ab1db7adfc5"
    },
    {
      "variant": "both",
      "exitCode": 0,
      "logSha256": "f1945cd6c19e56b3c1c78943ef5ec18116907a4ca1efc40a57d48ab1db7adfc5"
    }
  ],
  "limits": [
    "Other picture formats, sizing, transparent color and standard icons require separate acceptance.",
    "No full Configurator form pixels, Windows, DPI or 8.5 acceptance."
  ],
  "preparationNotes": [
    "The initial hand-authored Logo id 10 and OwnLogo id 11 collided with auxiliary IDs. All three forms were re-imported with unique primary IDs 100/101 and all 11 observations plus two applicability checks repeated. Only the v2 native exports and screenshots are accepted. Initial snapshots and logs remain in the playground."
  ]
